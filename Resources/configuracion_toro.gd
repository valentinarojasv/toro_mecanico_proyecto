extends Resource
class_name ConfiguracionToro

# Controla la velocidad de giro del toro.
@export var velocidad_giro: float = 1.5

# Controla la fuerza del movimiento.
@export var fuerza_galope: float = 1.0

# Controla la frecuencia del galope.
@export var frecuencia_galope: float = 3.0

# Controla cuánto se inclina el toro.
@export var amplitud_inclinacion: float = 0.15
